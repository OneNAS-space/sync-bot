From c3656ba93a7ad3ba317da4a0111e89a61df50382 Mon Sep 17 00:00:00 2001
From: Jackie264 <jackie.han@gmail.com>
Date: Wed, 16 Sep 2026 10:10:11 +0800
Subject: [PATCH] Add LED configuration for Askey SBE1V1K board

Signed-off-by: Jackie264 <jackie.han@gmail.com>
---
 .../ipq95xx/base-files/etc/board.d/01_leds    | 34 +++++++++++++++++++
 1 file changed, 34 insertions(+)
 create mode 100644 target/linux/qualcommbe/ipq95xx/base-files/etc/board.d/01_leds

diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/board.d/01_leds b/target/linux/qualcommbe/ipq95xx/base-files/etc/board.d/01_leds
new file mode 100644
index 00000000000000..95d1c803e3bcfa
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/board.d/01_leds
@@ -0,0 +1,34 @@
+#
+# Copyright (c) 2015 The Linux Foundation. All rights reserved.
+# Copyright (c) 2011-2015 OpenWrt.org
+#
+
+. /lib/functions/uci-defaults.sh
+
+board_config_update
+
+board=$(board_name)
+
+case "$board" in
+askey,sbe1v1k)
+	# QCA8081 (lan1, 2.5G) port LEDs, speed-coded via the netdev trigger
+	#   2.5G: green on + activity blink
+	#   1G  : green + yellow on, both blink on activity
+	#   100M: yellow on + activity blink
+	ucidef_set_led_netdev "lan1_green" "lan1:green" \
+		"90000.mdio-1:1c:green:lan" "lan1" "link_2500 link_1000 tx rx"
+	ucidef_set_led_netdev "lan1_yellow" "lan1:yellow" \
+		"90000.mdio-1:1c:yellow:lan" "lan1" "link_1000 link_100 tx rx"
+	# RTL8261BE (wan, 10G) port LEDs, hardware-offloaded likewise:
+	#   green: on at 10G/5G/2.5G, blinks off with activity
+	#   amber: on at 1G/100M, blinks off with activity
+	ucidef_set_led_netdev "wan_green" "wan:green" \
+		"90000.mdio-1:00:green:wan" "wan" "link_10000 link_5000 link_2500 tx rx"
+	ucidef_set_led_netdev "wan_amber" "wan:amber" \
+		"90000.mdio-1:00:amber:wan" "wan" "link_1000 link_100 tx rx"
+	;;
+esac
+
+board_config_flush
+
+exit 0
