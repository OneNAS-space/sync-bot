From e5e1fd8a8a7e97c267b9164c2280fc6185475975 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Mon, 21 Sep 2026 21:23:44 +0800
Subject: [PATCH] Remove KERNEL_LOADADDR from ipq95xx.mk

Removed the KERNEL_LOADADDR setting for the device.

Signed-off-by: Jackie Han <jackie.han@gmail.com>
---
 target/linux/qualcommbe/image/ipq95xx.mk | 1 -
 1 file changed, 1 deletion(-)

diff --git a/target/linux/qualcommbe/image/ipq95xx.mk b/target/linux/qualcommbe/image/ipq95xx.mk
index 867017562df503..136f5bfa459cad 100644
--- a/target/linux/qualcommbe/image/ipq95xx.mk
+++ b/target/linux/qualcommbe/image/ipq95xx.mk
@@ -24,7 +24,6 @@ define Device/askey_sbe1v1k
 	DEVICE_ALT1_VENDOR := Spectrum
 	DEVICE_ALT1_MODEL := SBE1V1K
 	DEVICE_DTS_CONFIG := config@rtq7300t-rev0
-	KERNEL_LOADADDR := 0x42080000
 	SOC := ipq9570
 	DEVICE_PACKAGES := ath12k-firmware-qcn9274 f2fsck ipq-wifi-askey_sbe1v1k kmod-ath12k \
 		kmod-hwmon-pwmfan kmod-phy-realtek mkf2fs rtl826x-firmware
